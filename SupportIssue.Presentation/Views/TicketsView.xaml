<UserControl x:Class="SupportIssue.Presentation.Views.TicketsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SupportIssue.Presentation.Views"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="900"
             Loaded="TicketsView_Loaded">
    <Border Background="White"
            CornerRadius="18"
            Padding="28">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Rad 0: rubrik -->
            <StackPanel Grid.Row="0">
                <TextBlock Text="Sök ärenden"
                           Style="{StaticResource FieldLabel}"
                           FontSize="28"
                           FontWeight="Bold"/>

                <TextBlock Text="Sök på rubrik eller kund och filtrera på status"
                           Style="{StaticResource FieldLabel}"
                           FontSize="14"
                           Margin="0,5,0,20"/>
            </StackPanel>

            <!-- Rad 1: sökfält, status och knappar -->
            <Grid Grid.Row="1" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Sök (rubrik eller kund)"
                               Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="SearchTextBox"
                             Style="{StaticResource TextBox}"
                             KeyDown="SearchTextBox_KeyDown"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock Text="Status"
                               Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="StatusComboBox"
                              Style="{StaticResource ComboBoxStyle}"
                              SelectionChanged="StatusComboBox_SelectionChanged">
                        <ComboBoxItem Content="Alla" IsSelected="True"/>
                        <ComboBoxItem Content="Nytt"/>
                        <ComboBoxItem Content="Pågående"/>
                        <ComboBoxItem Content="Löst"/>
                    </ComboBox>
                </StackPanel>

                <Button x:Name="SearchButton"
                        Grid.Column="2"
                        Content="Sök"
                        Margin="12,0,0,0"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource ButtonStyle}"
                        Click="SearchButton_Click"/>

                <Button x:Name="ShowAllButton"
                        Grid.Column="3"
                        Content="Visa alla"
                        Margin="8,0,0,0"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource ButtonStyle}"
                        Click="ShowAllButton_Click"/>
            </Grid>

            <!-- Rad 2: meddelande -->
            <TextBlock x:Name="MessageText"
                       Grid.Row="2"
                       Foreground="#475569"
                       Margin="0,0,0,10"/>

            <!-- Rad 3: listan -->
            <DataGrid x:Name="TicketsDataGrid"
                      Grid.Row="3"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Rubrik" Binding="{Binding Title}" Width="*"/>
                    <DataGridTextColumn Header="Kund" Binding="{Binding CustomerName}" Width="180"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="110"/>
                    <DataGridTextColumn Header="Prioritet" Binding="{Binding PriorityText}" Width="90"/>
                    <DataGridTextColumn Header="Skapad" Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm}" Width="140"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</UserControl>
