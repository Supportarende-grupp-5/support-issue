<UserControl x:Class="SupportIssue.Presentation.Views.RegisterTicketView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0B1F3A"
             FontFamily="Segoe UI"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <UserControl.Resources>

        <!-- Rubriker ovanför fälten -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Textfält med rundade hörn -->
        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="MinHeight" Value="46"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">

                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin"
                                     Value="True">
                                <Setter TargetName="InputBorder"
                                        Property="BorderBrush"
                                        Value="#2563EB"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="InputBorder"
                                        Property="Opacity"
                                        Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinHeight" Value="46"/>
            <Setter Property="Padding" Value="12,8"/>
           <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
<Setter Property="VerticalContentAlignment" Value="Stretch"/>
        </Style>

        <!-- Registreringsknappen -->
        <Style x:Key="RegisterButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="24,14"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#1D4ED8"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#1E40AF"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#E2E8F0"/>
                                <Setter Property="Foreground"
                                        Value="#64748B"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <!-- Kortet fyller fliken utan en begränsad maxbredd -->
    <Border Background="White"
            CornerRadius="18"
            Padding="28">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Rubrik -->
            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <TextBlock Text="Register a ticket"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#0F172A"/>

                <TextBlock Text="Describe the issue and select the customer."
                           FontSize="14"
                           Foreground="#64748B"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <!-- Scroll behövs bara när höjden inte räcker -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <Grid Margin="0,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Vänster: ärendets innehåll -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Title"
                                   Style="{StaticResource FieldLabel}"/>

                        <TextBox Grid.Row="1"
                                 x:Name="TitleTextBox"
                                 AutomationProperties.Name="Title"
                                 Margin="0,0,0,22"/>

                        <TextBlock Grid.Row="2"
                                   Text="Description"
                                   Style="{StaticResource FieldLabel}"/>

                        <TextBox Grid.Row="3"
                                 x:Name="DescriptionTextBox"
                                 AutomationProperties.Name="Description"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto"
                                 MinHeight="210"/>
                    </Grid>

                    <!-- Höger: kund och prioritet -->
                    <Border Grid.Column="2"
                            Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20"
                            VerticalAlignment="Top">

                        <StackPanel>
                            <TextBlock Text="Ticket details"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="#0F172A"
                                       Margin="0,0,0,22"/>

                            <TextBlock Text="Customer"
                                       Style="{StaticResource FieldLabel}"/>

                            <ComboBox x:Name="CustomerComboBox"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Id"
                                      AutomationProperties.Name="Customer"
                                      Margin="0,0,0,22"/>

                            <TextBlock Text="Priority"
                                       Style="{StaticResource FieldLabel}"/>

                            <ComboBox x:Name="PriorityComboBox"
                                      AutomationProperties.Name="Priority"
                                      Margin="0,0,0,24"/>

                            <Border Background="#EFF6FF"
                                    CornerRadius="10"
                                    Padding="14">

                                <TextBlock
                                    Text="An ID and creation date are assigned automatically. The initial status is New."
                                    Foreground="#1E40AF"
                                    FontSize="13"
                                    TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>

            <!-- Meddelande och knapp ligger kvar längst ned -->
            <Border Grid.Row="2"
                    BorderBrush="#E2E8F0"
                    BorderThickness="0,1,0,0"
                    Padding="0,20,0,0"
                    Margin="0,24,0,0">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="FeedbackTextBlock"
                               Grid.Column="0"
                               Foreground="#334155"
                               FontSize="14"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Margin="0,0,24,0"
                               AutomationProperties.LiveSetting="Polite"/>

                    <Button x:Name="RegisterButton"
                            Grid.Column="1"
                            Content="Register ticket"
                            Style="{StaticResource RegisterButtonStyle}"
                            IsEnabled="False"
                            Click="RegisterButton_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>