<UserControl x:Class="SupportIssue.Presentation.Views.RegisterTicketView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0B1F3A"
             FontFamily="Segoe UI"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">


    <!-- Kortet fyller fliken utan en begränsad maxbredd -->
    <Border Background="White"
            CornerRadius="18"
            Padding="28">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Rubrik -->
            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <TextBlock Text="Registrera ärende"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#0F172A"/>

                <TextBlock Text="Beskriv ärendet och välj kund."
                           FontSize="14"
                           Foreground="#64748B"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <!-- Scroll behövs bara när höjden inte räcker -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <Grid Margin="0,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Vänster: ärendets innehåll -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Rubrik"
                                   Style="{StaticResource FieldLabel}"/>

                        <TextBox Grid.Row="1"
                                 x:Name="TitleTextBox"
                                 AutomationProperties.Name="Rubrik"
                                 Margin="0,0,0,22"/>

                        <TextBlock Grid.Row="2"
                                   Text="Beskrivning"
                                   Style="{StaticResource FieldLabel}"/>

                        <TextBox Grid.Row="3"
                                 x:Name="DescriptionTextBox"
                                 AutomationProperties.Name="Beskrivning"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto"
                                 MinHeight="210"/>
                    </Grid>

                    <!-- Höger: kund och prioritet -->
                    <Border Grid.Column="2"
                            Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20"
                            VerticalAlignment="Top">

                        <StackPanel>
                            <TextBlock Text="Ärendedetaljer"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="#0F172A"
                                       Margin="0,0,0,22"/>

                            <TextBlock Text="Kund"
                                       Style="{StaticResource FieldLabel}"/>

                            <ComboBox x:Name="CustomerComboBox"
                                      Style="{StaticResource ComboBoxStyle}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Id"
                                      AutomationProperties.Name="Kund"
                                      Margin="0,0,0,22"/>

                            <TextBlock Text="Prioritet"
                                       Style="{StaticResource FieldLabel}"/>

                            <ComboBox x:Name="PriorityComboBox"
                                      Style="{StaticResource ComboBoxStyle}"
                                      AutomationProperties.Name="Prioritet"
                                      Margin="0,0,0,24"/>

                            <Border Background="#EFF6FF"
                                    CornerRadius="10"
                                    Padding="14">

                                <TextBlock
                                    Text="Ett ID och ett skapandedatum tilldelas automatiskt. Ärendets startstatus är Nytt."
                                    Foreground="#1E40AF"
                                    FontSize="13"
                                    TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>

            <!-- Meddelande och knapp ligger kvar längst ned -->
            <Border Grid.Row="2"
                    BorderBrush="#E2E8F0"
                    BorderThickness="0,1,0,0"
                    Padding="0,20,0,0"
                    Margin="0,24,0,0">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="FeedbackTextBlock"
                               Grid.Column="0"
                               Foreground="#334155"
                               FontSize="14"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Margin="0,0,24,0"
                               AutomationProperties.LiveSetting="Polite"/>

                    <Button x:Name="RegisterButton"
                            Grid.Column="1"
                            Content="Registrera ärende"
                            Style="{StaticResource ButtonStyle}"
                            IsEnabled="False"
                            Click="RegisterButton_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>