<UserControl x:Class="SupportIssue.Presentation.Views.RegisterTicketView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3F6FB"
             Foreground="#172033"
             FontFamily="Segoe UI"
             FontSize="14">

    <UserControl.Resources>

        <!-- Rubriker ovanför fälten -->
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Textfält med rundade hörn och fokusmarkering -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#172033"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SelectionBrush" Value="#BFDBFE"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="FieldBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">

                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FieldBorder"
                                        Property="BorderBrush"
                                        Value="#94A3B8"/>
                            </Trigger>

                            <Trigger Property="IsKeyboardFocusWithin"
                                     Value="True">
                                <Setter TargetName="FieldBorder"
                                        Property="BorderBrush"
                                        Value="#2563EB"/>
                                <Setter TargetName="FieldBorder"
                                        Property="BorderThickness"
                                        Value="2"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="FieldBorder"
                                        Property="Opacity"
                                        Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Behåller WPF:s inbyggda dropdown och tangentbordsstöd -->
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#172033"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Registreringsknapp -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="24,13"/>
            <Setter Property="MinHeight" Value="46"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="2"
                                CornerRadius="8">

                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#1D4ED8"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#1E40AF"/>
                            </Trigger>

                            <Trigger Property="IsKeyboardFocused"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#172033"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#E2E8F0"/>
                                <Setter Property="Foreground"
                                        Value="#64748B"/>
                                <Setter Property="Cursor"
                                        Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <Grid Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*" MaxWidth="680"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Spänner över hela bredden men begränsas till 680 -->
            <StackPanel Grid.ColumnSpan="3"
                        MaxWidth="680"
                        HorizontalAlignment="Stretch">

                <TextBlock Text="SUPPORT CENTER"
                           Foreground="#2563EB"
                           FontSize="12"
                           FontWeight="Bold"
                           Margin="0,0,0,10"/>

                <TextBlock Text="Register a ticket"
                           FontSize="30"
                           FontWeight="Bold"
                           TextWrapping="Wrap"/>

                <TextBlock
                    Text="Describe the issue and select the customer who needs help."
                    Foreground="#64748B"
                    TextWrapping="Wrap"
                    Margin="0,8,0,24"/>

                <Border Background="White"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="28">

                    <Border.Effect>
                        <DropShadowEffect Color="#172033"
                                          BlurRadius="20"
                                          ShadowDepth="4"
                                          Opacity="0.07"/>
                    </Border.Effect>

                    <StackPanel>

                        <TextBlock Text="Ticket details"
                                   FontSize="20"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="All fields are required."
                                   Foreground="#64748B"
                                   FontSize="12"
                                   Margin="0,6,0,24"/>

                        <Label Content="_Title"
                               Target="{Binding ElementName=TitleTextBox}"/>

                        <TextBox x:Name="TitleTextBox"
                                 AutomationProperties.Name="Title"/>

                        <TextBlock Text="Use a short, clear summary of the issue."
                                   Foreground="#64748B"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,20"/>

                        <Label Content="_Description"
                               Target="{Binding ElementName=DescriptionTextBox}"/>

                        <TextBox x:Name="DescriptionTextBox"
                                 Height="140"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto"
                                 AutomationProperties.Name="Description"/>

                        <TextBlock
                            Text="Explain what happened and include any error messages."
                            Foreground="#64748B"
                            FontSize="12"
                            TextWrapping="Wrap"
                            Margin="0,6,0,20"/>

                        <Label Content="_Customer"
                               Target="{Binding ElementName=CustomerComboBox}"/>

                        <ComboBox x:Name="CustomerComboBox"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  AutomationProperties.Name="Customer"
                                  Margin="0,0,0,20"/>

                        <Label Content="_Priority"
                               Target="{Binding ElementName=PriorityComboBox}"/>

                        <ComboBox x:Name="PriorityComboBox"
                                  AutomationProperties.Name="Priority"/>

                        <Border Background="#EFF6FF"
                                CornerRadius="8"
                                Padding="14"
                                Margin="0,24,0,0">

                            <TextBlock
                                Text="Your ticket will receive an ID, a creation date and the status New."
                                Foreground="#1E40AF"
                                FontSize="12"
                                TextWrapping="Wrap"/>
                        </Border>

                        <Border Height="1"
                                Background="#E2E8F0"
                                Margin="0,24"/>

                        <Button x:Name="RegisterButton"
                                Content="Register ticket"
                                Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Right"
                                IsEnabled="False"/>

                        <TextBlock x:Name="FeedbackTextBlock"
                                   Foreground="#334155"
                                   TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite"
                                   Margin="0,14,0,0"/>

                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>