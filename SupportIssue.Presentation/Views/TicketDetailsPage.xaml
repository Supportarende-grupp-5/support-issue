<Page x:Class="SupportIssue.Presentation.Views.TicketDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SupportIssue.Presentation.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="TicketDetailsPage">
      

    <Grid>
        <StackPanel>
            <TextBlock Text="{Binding Title}" />
            <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding Status}"/>
            <TextBlock Text="{Binding Priority}"/>
            <TextBlock Text="{Binding TechnicianName}" />
            <ListView ItemsSource="{Binding Comments}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Comment}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding CreatedAt}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBox Text="{Binding NewCommentText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button Name="AddCommentButton" Margin="2" >
                Add Comment
            </Button>
        </StackPanel>
    </Grid>
</Page>
