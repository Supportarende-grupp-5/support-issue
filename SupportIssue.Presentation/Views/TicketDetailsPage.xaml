<UserControl x:Class="SupportIssue.Presentation.Views.TicketDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:SupportIssue.Presentation.Views"
      mc:Ignorable="d"
      >

    <Grid IsEnabled="{Binding IsNotBusy}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
            <TextBlock Text="{Binding Title}" 
                      Foreground="#0F172A"
                       FontSize="22"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Margin="4" />
            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="4" />
            <TextBlock Text="{Binding CustomerName}" Margin="4" />
            <TextBlock Text="{Binding Status}" Margin="4" />
            <TextBlock Text="{Binding Priority}" Margin="4" />
            <TextBlock Text="{Binding TechnicianName}" Margin="4" />

            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="4" />
            <Button Command="{Binding CloseTicketCommand}" Style="{StaticResource ButtonStyle}">
                Stäng ärende
            </Button>
            <TextBlock Text="Rubrik" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="UpdateTitleTextBox"
                     Text="{Binding UpdateTitleText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     MinHeight="60" 
                     MaxHeight="120"
                     VerticalScrollBarVisibility="Auto"
                     Margin="4" />
            <Button x:Name="UpdateTitleButton" Command="{Binding UpdateTitleCommand}" Style="{StaticResource ButtonStyle}">
                Uppdatera rubrik
            </Button>

            <TextBlock Text="Beskrivning" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="UpdateDescriptionTextBox"
                     Text="{Binding UpdateDescriptionText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" 
                     TextWrapping="Wrap" 
                     MinHeight="60" 
                     MaxHeight="120"
                     VerticalScrollBarVisibility="Auto" 
                     Margin="4" />
            <Button x:Name="UpdateDescriptionButton" Command="{Binding UpdateDescriptionCommand}"  Style="{StaticResource ButtonStyle}">
                Uppdatera beskrivning
            </Button>
        </StackPanel>
        <StackPanel Grid.Column="1">
            <TextBlock Text="Kommentarer" FontWeight="Bold" Margin="4" />
            <ListView x:Name="CommentsListView" ItemsSource="{Binding Comments}" ScrollViewer.CanContentScroll="True" Height="150">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding Comment}" TextWrapping="Wrap" Margin="4" />
                        <TextBlock Text="{Binding CreatedAt}" Margin="4" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBox x:Name="NewCommentTextBox" 
                 Text="{Binding NewCommentText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                 AcceptsReturn="True" 
                TextWrapping="Wrap" 
                MinHeight="60" 
                MaxHeight="120"
                VerticalScrollBarVisibility="Auto" 
                Margin="4" />
            <Button Name="AddCommentButton"
                Margin="2"
                Command="{Binding AddCommentCommand}"
                Style="{StaticResource ButtonStyle}">
                Lägg till kommentar
            </Button>

            <ComboBox
                    Style="{StaticResource ComboBoxStyle}"
                    ItemsSource="{Binding Technicians}"
                    DisplayMemberPath="TechnicianName"
                    SelectedItem="{Binding SelectedTechnician, Mode=TwoWay}" />
            <Button x:Name="AssignTechnicianButton" Command="{Binding AssignSelectedTechnicianCommand}" Style="{StaticResource ButtonStyle}">
                Tilldela handläggare
            </Button>
            <ComboBox
                    Style="{StaticResource ComboBoxStyle}"
                    ItemsSource="{Binding PriorityOptions}"
                    SelectedItem="{Binding SelectedPriority, Mode=TwoWay}" />
            <Button x:Name="AssignPriorityButton" Command="{Binding ChangePriorityCommand}" Style="{StaticResource ButtonStyle}">
                Tilldela prioritet
            </Button>
        </StackPanel>

    </Grid>
</UserControl>
