<UserControl x:Class="SupportIssue.Presentation.Views.TicketDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:SupportIssue.Presentation.Views"
      mc:Ignorable="d"
      >



    <UserControl.Resources>

        <!-- Rubriker ovanför fälten -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Textfält med rundade hörn -->
        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="MinHeight" Value="46"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">

                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin"
                                     Value="True">
                                <Setter TargetName="InputBorder"
                                        Property="BorderBrush"
                                        Value="#2563EB"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="InputBorder"
                                        Property="Opacity"
                                        Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinHeight" Value="46"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        

    </UserControl.Resources>





    <Grid IsEnabled="{Binding IsNotBusy}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
            <TextBlock Text="{Binding Title}" 
                      Foreground="#0F172A"
                       FontSize="22"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Margin="4" />
            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="4" />
            <TextBlock Text="{Binding CustomerName}" Margin="4" />
            <TextBlock Text="{Binding Status}" Margin="4" />
            <TextBlock Text="{Binding Priority}" Margin="4" />
            <TextBlock Text="{Binding TechnicianName}" Margin="4" />

            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="4" />
            <Button Command="{Binding CloseTicketCommand}" Style="{StaticResource ButtonStyle}">
                Stäng ärende
            </Button>
            <TextBlock Text="Rubrik" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="UpdateTitleTextBox"
                     Text="{Binding UpdateTitleText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     MinHeight="60" 
                     MaxHeight="120"
                     VerticalScrollBarVisibility="Auto"
                     Margin="4" />
            <Button x:Name="UpdateTitleButton" Command="{Binding UpdateTitleCommand}" Style="{StaticResource ButtonStyle}">
                Uppdatera rubrik
            </Button>

            <TextBlock Text="Beskrivning" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="UpdateDescriptionTextBox"
                     Text="{Binding UpdateDescriptionText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" 
                     TextWrapping="Wrap" 
                     MinHeight="60" 
                     MaxHeight="120"
                     VerticalScrollBarVisibility="Auto" 
                     Margin="4" />
            <Button x:Name="UpdateDescriptionButton" Command="{Binding UpdateDescriptionCommand}"  Style="{StaticResource ButtonStyle}">
                Uppdatera beskrivning
            </Button>
        </StackPanel>
        <StackPanel Grid.Column="1">
            <TextBlock Text="Kommentarer" FontWeight="Bold" Margin="4" />
            <ListView x:Name="CommentsListView" ItemsSource="{Binding Comments}" ScrollViewer.CanContentScroll="True" Height="150">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding Comment}" TextWrapping="Wrap" Margin="4" />
                        <TextBlock Text="{Binding CreatedAt}" Margin="4" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBox x:Name="NewCommentTextBox" 
                 Text="{Binding NewCommentText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                 AcceptsReturn="True" 
                TextWrapping="Wrap" 
                MinHeight="60" 
                MaxHeight="120"
                VerticalScrollBarVisibility="Auto" 
                Margin="4" />
            <Button Name="AddCommentButton"
                Margin="2"
                Command="{Binding AddCommentCommand}"
                Style="{StaticResource ButtonStyle}">
                Lägg till kommentar
            </Button>

            <ComboBox
                    ItemsSource="{Binding Technicians}"
                    DisplayMemberPath="TechnicianName"
                    SelectedItem="{Binding SelectedTechnician, Mode=TwoWay}" />
            <Button x:Name="AssignTechnicianButton" Command="{Binding AssignSelectedTechnicianCommand}" Style="{StaticResource ButtonStyle}">
                Tilldela handläggare
            </Button>
            <ComboBox
                    ItemsSource="{Binding PriorityOptions}"
                    SelectedItem="{Binding SelectedPriority, Mode=TwoWay}" />
            <Button x:Name="AssignPriorityButton" Command="{Binding ChangePriorityCommand}" Style="{StaticResource ButtonStyle}">
                Tilldela prioritet
            </Button>
        </StackPanel>

    </Grid>
</UserControl>
