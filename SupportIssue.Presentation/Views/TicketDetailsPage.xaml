<Page x:Class="SupportIssue.Presentation.Views.TicketDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:SupportIssue.Presentation.Views"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="450"
      Title="TicketDetailsPage">


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding Title}" Margin="4" />
            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="4" />
            <TextBlock Text="{Binding Status}" Margin="4" />
            <TextBlock Text="{Binding Priority}" Margin="4" />
            <TextBlock Text="{Binding TechnicianName}" Margin="4" />
            <ListView x:Name="CommentsListView" ItemsSource="{Binding Comments}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Comment}" TextWrapping="Wrap" Margin="4" />
                            <TextBlock Text="{Binding CreatedAt}" Margin="4" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBox x:Name="NewCommentTextBox" Text="{Binding NewCommentText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="4" />
            <Button Name="AddCommentButton"
                Margin="2"
                Click="AddCommentButton_Click">
                Lägg till kommentar
            </Button>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">

                <ComboBox 
                    ItemsSource="{Binding Technicians}"
                    DisplayMemberPath="TechnicianName"
                    SelectedItem="{Binding SelectedTechnician, Mode=TwoWay}" />
                <Button x:Name="AssignTechnicianButton" Click="AssignTechnicianButton_Click">
                    Tilldela handläggare
                </Button>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <ComboBox 
                    ItemsSource="{Binding PriorityOptions}"
                    SelectedItem="{Binding SelectedPriority, Mode=TwoWay}" />
                <Button x:Name="AssignPriorityButton" Click="AssignPriorityButton_Click">
                    Tilldela prioritet
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
