<UserControl x:Class="SupportIssue.Presentation.Views.CustomerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SupportIssue.Presentation.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <StackPanel Margin="30">
            <TextBlock Text="Kunder"
                       FontSize="28"
                       FontWeight="Bold"/>
            
            <TextBlock Text="Hantera och registrera kunder"
                       FontSize="14"
                       Margin="0,5,0,20"/>
            
            <TextBlock Text="Namn"
                       FontWeight="SemiBold"
                          Margin="0,0,0,5"/>
            
            <TextBox x:Name="NameTextBox"
                     Height="32"
                     Margin="0,0,0,15"/>
            
            <TextBlock Text="E-post"
                       FontWeight="SemiBold"
                       Margin="0,0,0,5"/>
            <TextBox x:Name="EmailTextBox"
                     Height="32"
                     Margin="0,0,0,15"/>

            <StackPanel Orientation="Horizontal"
            Margin="0,0,0,20">

                <Button x:Name="AddCustomerButton"
            Content="Lägg till kund"
            Height="35"
            Width="140"
            Margin="0,0,10,0"
            Click="AddCustomerButton_Click"/>

                <Button x:Name="UpdateCustomerButton"
            Content="Uppdatera kund"
            Height="35"
            Width="140"
            Click="UpdateCustomerButton_Click"/>

            </StackPanel>

            <TextBlock Text="Kundlista"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>

            <DataGrid x:Name="CustomersDataGrid"
                      AutoGenerateColumns="False"
                      Height="250"
                      IsReadOnly="True"
                      SelectionChanged="CustomersDataGrid_SelectionChanged">

                <DataGrid.Columns>
                          <DataGridTextColumn Header="Namn" Binding="{Binding Name}" Width="*"/>
                          <DataGridTextColumn Header="E-post" Binding="{Binding Email}" Width="*"/>

                </DataGrid.Columns>
            </DataGrid>
            
        </StackPanel>        
            
    </Grid>
</UserControl>
