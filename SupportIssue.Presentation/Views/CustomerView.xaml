<UserControl x:Class="SupportIssue.Presentation.Views.CustomerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SupportIssue.Presentation.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>

        <!-- Rubriker ovanför fälten -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Textfält med rundade hörn -->
        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="MinHeight" Value="46"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">

                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin"
                                     Value="True">
                                <Setter TargetName="InputBorder"
                                        Property="BorderBrush"
                                        Value="#2563EB"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="InputBorder"
                                        Property="Opacity"
                                        Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinHeight" Value="46"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        </Style>

        <!-- Registreringsknappen -->
        <Style x:Key="RegisterButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="24,14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="10"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#1D4ED8"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#1E40AF"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#E2E8F0"/>
                                <Setter Property="Foreground"
                                        Value="#64748B"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>
    <Grid>
        <StackPanel Margin="30">
            <TextBlock Text="Kunder"
                       FontSize="28"
                       FontWeight="Bold"/>
            
            <TextBlock Text="Hantera och registrera kunder"
                       FontSize="14"
                       Margin="0,5,0,20"/>
            
            <TextBlock Text="Namn"
                       FontWeight="SemiBold"
                          Margin="0,0,0,5"/>
            
            <TextBox x:Name="NameTextBox"
                     Height="32"
                     Margin="0,0,0,15"/>
            
            <TextBlock Text="E-post"
                       FontWeight="SemiBold"
                       Margin="0,0,0,5"/>
            <TextBox x:Name="EmailTextBox"
                     Height="32"
                     Margin="0,0,0,15"/>

            <StackPanel Orientation="Horizontal"
            Margin="0,0,0,20">

                <Button x:Name="AddCustomerButton"
            Content="Lägg till kund"
            Style="{StaticResource RegisterButtonStyle}"
            Click="AddCustomerButton_Click"/>

                <Button x:Name="UpdateCustomerButton"
            Content="Uppdatera kund"
            Style="{StaticResource RegisterButtonStyle}"
            Click="UpdateCustomerButton_Click"/>

            </StackPanel>

            <TextBlock Text="Kundlista"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>

            <DataGrid x:Name="CustomersDataGrid"
                      AutoGenerateColumns="False"
                      Height="250"
                      IsReadOnly="True"
                      SelectionChanged="CustomersDataGrid_SelectionChanged">

                <DataGrid.Columns>
                          <DataGridTextColumn Header="Namn" Binding="{Binding Name}" Width="*"/>
                          <DataGridTextColumn Header="E-post" Binding="{Binding Email}" Width="*"/>

                </DataGrid.Columns>
            </DataGrid>
            
        </StackPanel>        
            
    </Grid>
</UserControl>
