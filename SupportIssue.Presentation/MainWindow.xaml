<Window x:Class="SupportIssue.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SupportIssue – Ticket registration"
        Height="750"
        Width="1000"
        MinHeight="550"
        MinWidth="750"
        WindowStartupLocation="CenterScreen"
        Background="#F3F6FB">

    <Grid Margin="16">
        <TabControl>
            <TabItem Header="Customers">
                <ContentControl x:Name="CustomerContent"/>
            </TabItem>

            <TabItem Header="Register ticket">
                <ContentControl x:Name="TicketContent"/>
            </TabItem>
        </TabControl>
    </Grid>
</Window>